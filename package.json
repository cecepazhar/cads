{
  "name": "@cecepazhar/caui",
  "version": "1.0.0",
  "description": "CAUI — CA Design System by Cecep Saeful Azhar Hidayat, ST. Unified Svelte 5 component suite and tokens for 17 CA apps.",
  "author": "Cecep Saeful Azhar Hidayat, ST <hi@cecepazhar.com> (https://www.cecepazhar.com)",
  "homepage": "https://www.cecepazhar.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cecepazhar/caui.git"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens/tokens.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "package": "svelte-kit sync && svelte-package",
    "publint": "publint",
    "prepublishOnly": "pnpm run package && pnpm run publint",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.1.2",
    "lucide-svelte": "^0.474.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
